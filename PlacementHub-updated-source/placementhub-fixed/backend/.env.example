# ---- Flask ----
APP_ENV=development            # development | production | testing
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# ---- Database (MySQL 8) ----
# Create the database first:  CREATE DATABASE placementhub CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL=mysql+pymysql://placementhub_user:CHANGE_ME@127.0.0.1:3306/placementhub

# ---- CAPTCHA ----
# turnstile (production) or local (development/testing only; refused when APP_ENV=production)
CAPTCHA_PROVIDER=local
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Sessions / cookies ----
SESSION_COOKIE_SECURE=false    # set true behind HTTPS
SESSION_IDLE_MINUTES=30
REMEMBER_ME_DAYS=14

# ---- Mail (password reset links) ----
# console = print reset link in the server log (development). smtp = send real mail.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=placementhub@example.edu
PUBLIC_APP_URL=http://localhost:3000

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
